@page "/bookcatalog"
@rendermode InteractiveServer
@using Microsoft.Data.Sqlite
@using BlazorApp2.Data
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Cryptography


<h3>BookCatalog</h3>

<p style="color: @(isError ? "red" : "black")">@statusmessage</p>

<EditForm Model="newBook" OnSubmit="HandleAdd">
	<InputText @bind-Value="newBook.Title" placeholder="Title" />
	<InputText @bind-Value="newBook.Author" placeholder="Author" />
	<InputNumber @bind-Value="newBook.Total" placeholder="Total" />
	<button type="submit">Add Book</button>
</EditForm>

<table>
	<thead>
		<tr>
			<th>Id</th>
			<th>Title</th>
			<th>Author</th>
			<th>Total</th>
			<th>Available</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var book in books)
		{
			<tr>
				<td>@book.Id</td>
				<td>@book.Title</td>
				<td>@book.Author</td>
				<td>@book.Total</td>
				<td>@book.Available</td>
			</tr>
		}
	</tbody>
</table>

@code {

	private string statusmessage = "Initializing database...";

	private void InitializeDatabase()
	{
		using var connection = new SqliteConnection("Data Source=bookcatalog.db");
		connection.Open();

		var command = connection.CreateCommand();
			command.CommandText = @"
				CREATE TABLE IF NOT EXISTS Books (
					Id INTEGER PRIMARY KEY AUTOINCREMENT,
					Title TEXT NOT NULL,
					Author TEXT NOT NULL,
					Total INTEGER NOT NULL,
					Available INTEGER NOT NULL
				)";
		command.ExecuteNonQuery();
		statusmessage = "Database initialized.";
	}

	private void Users()
	{
		using var connection = new SqliteConnection("Data Source=bookcatalog.db");
		connection.Open();
		var command = connection.CreateCommand();
		command.CommandText = @"
			CREATE TABLE IF NOT EXISTS Users (
				Id INTEGER PRIMARY KEY AUTOINCREMENT,
				Name TEXT NOT NULL,
				PasswordHash TEXT NOT NULL,
				Salt TEXT NOT NULL,
				Role TEXT NOT NULL
			)";
		command.ExecuteNonQuery();
	}

	private void AddBook(string title, string author, int total, int available)
	{
		using var connection = new SqliteConnection("Data Source=bookcatalog.db");
		connection.Open();
		var command = connection.CreateCommand();
		command.CommandText = @"
			INSERT INTO Books (Title, Author, Total, Available)
			VALUES ($title, $author, $total, $available)";
		command.Parameters.AddWithValue("$title", title);
		command.Parameters.AddWithValue("$author", author);
		command.Parameters.AddWithValue("$total", total);
		command.Parameters.AddWithValue("$available", available);
		command.ExecuteNonQuery();
	}

	private List<Book> GetBooks()
	{
		var books = new List<Book>();
		using var connection = new SqliteConnection("Data Source=bookcatalog.db");
		connection.Open();
		var command = connection.CreateCommand();
		command.CommandText = "SELECT Id, Title, Author, Total, Available FROM Books";
		using var reader = command.ExecuteReader();
		while (reader.Read())
		{
			var book = new Book
			{
				Id = reader.GetInt32(0),
				Title = reader.GetString(1),
				Author = reader.GetString(2),
				Total = reader.GetInt32(3),
				Available = reader.GetInt32(4)
			};
			books.Add(book);
		}
		return books;
	}
	
	private Book newBook = new Book();

	private bool isError = false;

	private void HandleAdd()
	{
		if (!string.IsNullOrWhiteSpace(newBook.Title) && !string.IsNullOrWhiteSpace(newBook.Author) && newBook.Total > 0)
		{
			newBook.Available = newBook.Total; // Set available to total when adding a new book
			AddBook(newBook.Title, newBook.Author, newBook.Total, newBook.Available);
			books = GetBooks(); // Refresh the list of books
			newBook = new Book(); // Reset the form
			statusmessage = "Book added successfully.";
			isError = false;
		}
		else
		{
			statusmessage = "ERROR: - Please fill in all fields and ensure Total is greater than 0.";
			isError = true;
		}
	}

	private static string HashPassword(string password, string salt)
	{
		byte[] saltBytes = Convert.FromBase64String(salt);
		using var pbkdf2 = new Rfc2898DeriveBytes(password, saltBytes, 100_000, HashAlgorithmName.SHA256);
		return Convert.ToBase64String(pbkdf2.GetBytes(32));
	}

	private static bool VerifyPassword(string password, string salt, string hash)
	{
		var computedHash = HashPassword(password, salt);
		return computedHash == hash;
	}

	private List<Book> books = new List<Book>();

	private void seedtestuser()
	{
		using var connection = new SqliteConnection("Data Source=bookcatalog.db");
		connection.Open();

		var countCommand = connection.CreateCommand();
		countCommand.CommandText = "SELECT COUNT(*) FROM Users";
		long count = (long)countCommand.ExecuteScalar();

		if (count > 0)
		{
			return; // Der findes allerede brugere, spring seedingen over
		}

		var command = connection.CreateCommand();
		command.CommandText = @"
        INSERT INTO Users (Name, PasswordHash, Salt, Role)
        VALUES ($name, $passwordHash, $salt, $role)";

		string salt = Convert.ToBase64String(RandomNumberGenerator.GetBytes(16));
		string passwordHash = HashPassword("1234", salt);

		command.Parameters.AddWithValue("$name", "elev1");
		command.Parameters.AddWithValue("$passwordHash", passwordHash);
		command.Parameters.AddWithValue("$salt", salt);
		command.Parameters.AddWithValue("$role", "Elev");

		command.ExecuteNonQuery();
	}

	protected override void OnInitialized()
	{
		InitializeDatabase();
		Users();
		seedtestuser();
		statusmessage = "Database initialized and test user seeded.";
		books = GetBooks();
	}
}
